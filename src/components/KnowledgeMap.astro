---
/**
 * KnowledgeMap — the figure at the foot of the homepage.
 *
 * Two separate things are drawn here and they must not merge. The **map** —
 * groups, bands, tile names — is a canonical decomposition of the field, taken
 * from the industry's own topic lists (IEDM / VLSI / DAC / ICCAD for silicon,
 * ACM CCS 2012 and OSTEP for systems, CMU 15-445 for data, the 2026 LLM
 * application stack for AI). A stranger in this field could grade themselves
 * against it. The **shading** is the owner's, and is the only subjective mark.
 *
 * The contract, which any change has to keep:
 *
 *   - vertical order is "runs on top of", not "flows into": each group is the
 *     substrate the one above it is built on, from an agent down to an atom
 *   - tiles run left to right along the real chain of that band — the fab flow,
 *     the back-end flow, the model lifecycle, the path of a query. Position
 *     carries meaning or the row is a list
 *   - the ramp is presence of ink, one burgundy family, never a colour code:
 *     nothing there, an outline, a filled step, solid
 *   - `{color.wash-deep}` is the filled step (GR-017); `{color.wash}` is 5.0%
 *     below canvas and disappears at this cell size
 *   - cells fill their row edge to edge like standard-cell rows. Bands are kept
 *     to 7-9 tiles upstream so no row wraps; `max-width` is the guard if one does
 *   - no arrows: adjacency in the stack *is* the relationship, and 96 tiles with
 *     arrows is spaghetti
 *   - legend is four words, ranged right so it ends on the plate's edge. A
 *     sentence per level invites the reader to argue with the definition
 *     instead of reading the map
 *   - labels spell out "and"; they must never contain "&". Archivo's ampersand
 *     is an epsilon-like form and the shipped subset carries no alternate
 *     (`salt` and `ss01` both return the same glyph), so at 11px it does not
 *     read as a conjunction at all. A borrowed ampersand from a second family
 *     would break the Archivo-only lock (GR-004) for one glyph
 *
 * Source data and the grading tool live in `Workspace/Study/knowledge-map/`.
 */
interface Level {
  id: string;
  rank: number;
  label: string;
}

interface Tile {
  name: string;
  level: string;
}

interface Band {
  id: string;
  label: string;
  order: string;
  tiles: Tile[];
}

interface Group {
  id: string;
  label: string;
  bands: Band[];
}

interface Props {
  levels: Level[];
  groups: Group[];
}

const { levels, groups } = Astro.props;

// Rank is the ramp, low to high. Sort here rather than trusting file order.
const ramp = [...levels].sort((a, b) => a.rank - b.rank);
---

<figure class="kmap">
  <ul class="kmap__legend" aria-label="How to read the shading">
    {
      ramp.map((level) => (
        <li class="kmap__legend-item">
          <span class={`kmap__chip kmap__chip--${level.id}`} aria-hidden="true" />
          {level.label}
        </li>
      ))
    }
  </ul>

  <div class="kmap__plate">
    {
      groups.map((group) => (
        <details class="kmap__group" open>
          <summary class="kmap__group-label" id={`kmap-${group.id}`}>
            {group.label}
          </summary>

          <div class="kmap__bands" aria-labelledby={`kmap-${group.id}`}>
            {group.bands.map((band) => (
              <div class="kmap__band">
                <h4 class="kmap__band-label" id={`kmap-band-${band.id}`}>
                  {band.label}
                </h4>
                {/* The list is the accessible reading; the shading is repeated
                    in each item's text so colour never carries meaning alone. */}
                <ul class="kmap__row" aria-labelledby={`kmap-band-${band.id}`}>
                  {band.tiles.map((tile) => (
                    <li class={`kmap__cell kmap__cell--${tile.level}`}>
                      {tile.name}
                      <span class="sr-only">
                        {": "}
                        {ramp.find((level) => level.id === tile.level)?.label}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>
      ))
    }
  </div>
</figure>

<style>
  .kmap {
    margin: 0;
  }

  /* Four words and the ink, ranged right so the legend ends on the same edge
     as the plate below it. */
  .kmap__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2) var(--space-6);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-mute);
  }

  .kmap__legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .kmap__chip {
    width: 1.5rem;
    height: 0.875rem;
    flex: none;
    background: var(--color-canvas);
    border: 1px solid var(--color-mute);
  }

  .kmap__chip--unexplored {
    border-color: var(--color-line);
    border-style: dashed;
  }

  .kmap__chip--working {
    background: var(--color-wash-deep);
  }

  .kmap__chip--expert {
    background: var(--color-display);
    border-color: var(--color-display);
  }

  /* The die. One hairline seal ring; the reticle ticks are the single accent. */
  .kmap__plate {
    position: relative;
    padding: var(--space-4);
    border: 1px solid var(--color-mute);
    background: var(--color-canvas);
  }

  .kmap__plate::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px solid var(--color-line);
    pointer-events: none;
  }

  .kmap__group {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-line);
  }

  .kmap__group:first-of-type {
    padding-top: 0;
    border-top: none;
  }

  .kmap__group:last-of-type {
    padding-bottom: 0;
  }

  .kmap__group-label {
    display: block;
    list-style: none;
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-display);
  }

  .kmap__group-label::-webkit-details-marker {
    display: none;
  }

  .kmap__band + .kmap__band {
    margin-top: var(--space-3);
  }

  .kmap__band-label {
    margin: 0 0 0.25rem 1px;
    font-size: 0.5938rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  /* Cells grow to fill the row edge to edge, the way a standard-cell row does. */
  .kmap__row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Basis is deliberately far below the rendered width. Wrapping in a flex row
     is decided on the basis before any growing happens, so 4.5rem keeps a
     nine-cell band on one line down to a 1024px laptop and then lets the cells
     grow to fill a 1312px measure. Raising it re-introduces wrapping on the
     most common laptop widths. */
  .kmap__cell {
    display: flex;
    flex: 1 1 4.5rem;
    align-items: center;
    justify-content: center;
    min-width: 0;
    max-width: 14rem;
    padding: 0.5rem 0.4375rem;
    border: 1px solid var(--color-mute);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    color: var(--color-mute);
    background: var(--color-canvas);
  }

  /* The ramp: nothing there, an outline, a filled step, solid. */
  .kmap__cell--unexplored {
    border-color: var(--color-line);
    border-style: dashed;
    opacity: 0.55;
  }

  .kmap__cell--working {
    background: var(--color-wash-deep);
    color: var(--color-body);
  }

  .kmap__cell--expert {
    background: var(--color-display);
    border-color: var(--color-display);
    color: var(--color-canvas);
  }

  /* Tablet: keep the figure legible rather than shrinking the desktop layout. */
  @media (max-width: 63.9375rem) {
    .kmap__group {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }

    .kmap__cell {
      flex-basis: 8rem;
      max-width: none;
    }
  }

  @media (max-width: 44.98rem) {
    .kmap__legend {
      justify-content: flex-start;
      gap: var(--space-2) var(--space-4);
    }

    .kmap__plate {
      padding: var(--space-3);
    }

    .kmap__group {
      gap: 0;
      padding-block: 0;
    }

    .kmap__group + .kmap__group {
      border-top: 1px solid var(--color-line);
    }

    .kmap__group-label {
      position: relative;
      display: flex;
      min-height: 2.75rem;
      align-items: center;
      padding-right: 2rem;
      cursor: pointer;
    }

    .kmap__group-label::after {
      position: absolute;
      right: 0.25rem;
      color: var(--color-mute);
      content: "+";
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: 0;
    }

    .kmap__group[open] > .kmap__group-label::after {
      content: "−";
    }

    .kmap__bands {
      padding-bottom: var(--space-4);
    }

    .kmap__cell {
      flex-basis: 7rem;
      min-height: 2.75rem;
    }
  }
</style>

<script>
  const setupKnowledgeMap = () => {
    const phone = window.matchMedia("(max-width: 44.98rem)");

    document.querySelectorAll<HTMLElement>(".kmap").forEach((map) => {
      if (map.dataset.phoneReady === "true") return;
      map.dataset.phoneReady = "true";

      const groups = Array.from(map.querySelectorAll<HTMLDetailsElement>(".kmap__group"));
      const compose = (isPhone: boolean) => {
        groups.forEach((group, index) => {
          group.open = !isPhone || index === 0;
        });
      };

      compose(phone.matches);
      phone.addEventListener("change", (event) => compose(event.matches));
    });
  };

  document.addEventListener("astro:page-load", setupKnowledgeMap);
  setupKnowledgeMap();
</script>
