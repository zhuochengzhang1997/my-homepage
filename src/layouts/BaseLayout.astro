---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import globalStylesheet from "../styles/global.css?url";
import tailwindStylesheet from "../styles/tailwind.css?url";

interface Props {
  title: string;
  description: string;
  canonical?: URL | string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url,
  image = "/og/default.png",
  noindex = false,
} = Astro.props;
const pageTitle = title.includes("Zhuocheng Zhang") ? title : `${title} | Zhuocheng Zhang`;
const canonicalUrl =
  canonical instanceof URL ? canonical : new URL(canonical, Astro.site ?? Astro.url);
const imageUrl = new URL(image, Astro.site ?? Astro.url);
const pathname = Astro.url.pathname;
const wash = pathname.startsWith("/research")
  ? "research"
  : pathname.startsWith("/essays")
    ? "essays"
    : pathname.startsWith("/publications")
      ? "publications"
      : pathname.startsWith("/studio")
        ? "studio"
        : "home";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Zhuocheng Zhang" />
    <meta name="theme-color" content="#fffbfa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={globalStylesheet} />
    <link rel="stylesheet" href={tailwindStylesheet} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zhuocheng Zhang" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body id="top" data-wash={wash}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <div class="page-main">
      <slot />
    </div>
    <SiteFooter />
    <script>
      import "../scripts/site-interactions";
    </script>
    {
      import.meta.env.DEV && (
        <script>
          import "../scripts/layout-nudge";
        </script>
      )
    }
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-control);
    background: var(--color-body);
    color: var(--color-canvas);
    font-size: var(--type-control);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
