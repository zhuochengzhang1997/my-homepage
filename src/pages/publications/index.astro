---
import { getCollection } from "astro:content";

import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

type UnknownRecord = Record<string, unknown>;

const toRecord = (value: unknown): UnknownRecord =>
  value && typeof value === "object" ? (value as UnknownRecord) : {};

const toText = (value: unknown): string =>
  typeof value === "string" || typeof value === "number" ? String(value) : "";

const toDateValue = (value: unknown): number => {
  if (value instanceof Date) return value.getTime();
  const parsed = Date.parse(toText(value));
  return Number.isNaN(parsed) ? 0 : parsed;
};

const isVisible = (data: UnknownRecord): boolean => {
  const verification = toRecord(data.verification);
  const status = toText(verification.status);
  return (
    data.draft !== true &&
    data.visibility !== "private" &&
    status !== "conflicted" &&
    status !== "legacy-only"
  );
};

const entries = await (getCollection as any)("publications");
const publications: Array<{ id: string; data: UnknownRecord }> = entries
  .map((entry: UnknownRecord) => ({
    id: toText(entry.id),
    data: toRecord(entry.data),
  }))
  .filter(({ data }: { data: UnknownRecord }) => isVisible(data))
  .sort((a: { id: string; data: UnknownRecord }, b: { id: string; data: UnknownRecord }) => {
    const yearDifference = Number(b.data.year ?? 0) - Number(a.data.year ?? 0);
    if (yearDifference) return yearDifference;

    const dateDifference = toDateValue(b.data.publishedAt) - toDateValue(a.data.publishedAt);
    if (dateDifference) return dateDifference;

    return (toText(a.data.title) || a.id).localeCompare(toText(b.data.title) || b.id);
  });

const [profileEntry] = await getCollection("profile");
const metrics = profileEntry.data.scholarMetrics;
const scholarUrl = profileEntry.data.identities?.scholar;
---

<BaseLayout
  title="Publications | Zhuocheng Zhang"
  description="Peer-reviewed work by Zhuocheng Zhang on oxide-semiconductor devices, reliability, and characterization, with links to his Google Scholar profile."
  image="/og/publications.png"
>
  <main id="main-content">
    <div class="section-band section-band--canvas page-lede-band">
      <div class="page-shell editorial-grid">
        <header class="page-intro page-lede-band__header">
          <p class="eyebrow">Scholarly work</p>
          <h1>Publications</h1>
          <p class="page-intro__lede">The device record behind the workflow work.</p>
          {
            metrics && (
              <p class="page-intro__stats">
                <span>{metrics.citationsLabel} citations</span>
                <span>h-index {metrics.hIndex}</span>
                {scholarUrl ? (
                  <a href={scholarUrl} rel="me external">
                    Google Scholar
                  </a>
                ) : (
                  <span>Google Scholar</span>
                )}
              </p>
            )
          }
        </header>
      </div>
    </div>

    {
      publications.length > 0 ? (
        <>
          <div class="section-band section-band--soft publication-ledger-band">
            <div class="page-shell">
              <p class="publication-results">
                {publications.length} {publications.length === 1 ? "publication" : "publications"}
              </p>

              <ol class="publication-list">
                {publications.map(({ id, data }: { id: string; data: UnknownRecord }) => {
                  const authors = Array.isArray(data.authors)
                    ? data.authors
                        .map((author) => {
                          if (typeof author === "string") return { name: author, isOwner: false };
                          const authorData = toRecord(author);
                          return {
                            name: toText(authorData.displayName) || toText(authorData.name),
                            isOwner: authorData.isSiteOwner === true,
                          };
                        })
                        .filter((author) => author.name)
                    : [];
                  const venue = toRecord(data.venue);
                  const venueName =
                    toText(venue.name) || toText(venue.fullName) || toText(venue.shortName);
                  const links = toRecord(data.links);
                  const doi = toText(data.doi);

                  return (
                    <li class="publication-entry editorial-grid">
                      <p class="publication-entry__year">{toText(data.year)}</p>

                      <div class="publication-entry__body">
                        <h2 id={`${id}-title`}>{toText(data.title) || id}</h2>
                        {authors.length > 0 && (
                          <p class="publication-entry__authors">
                            {authors.map((author, authorIndex) => (
                              <>
                                {author.isOwner ? <strong>{author.name}</strong> : author.name}
                                {authorIndex < authors.length - 1 && ", "}
                              </>
                            ))}
                          </p>
                        )}
                        {venueName && (
                          <p class="publication-entry__venue">
                            <span>{venueName}</span>
                          </p>
                        )}
                      </div>

                      <ul class="publication-entry__links" aria-labelledby={`${id}-title`}>
                        {doi && (
                          <li>
                            <a href={`https://doi.org/${doi}`} rel="external">
                              <Icon name="external-link" size={14} />
                              DOI
                            </a>
                          </li>
                        )}
                        {toText(links.publisher) && (
                          <li>
                            <a href={toText(links.publisher)} rel="external">
                              <Icon name="external-link" size={14} />
                              Publisher
                            </a>
                          </li>
                        )}
                        {toText(links.preprint) && (
                          <li>
                            <a href={toText(links.preprint)} rel="external">
                              <Icon name="file-text" size={14} />
                              Preprint
                            </a>
                          </li>
                        )}
                        {toText(links.code) && (
                          <li>
                            <a href={toText(links.code)} rel="external">
                              <Icon name="code" size={14} />
                              Code
                            </a>
                          </li>
                        )}
                      </ul>
                    </li>
                  );
                })}
              </ol>
            </div>
          </div>
        </>
      ) : (
        <div class="section-band section-band--soft">
          <section class="content-status page-shell" aria-labelledby="publication-status-title">
            <h2 id="publication-status-title">The complete list lives on Google Scholar</h2>
            <p>Follow the Google Scholar link above for the full publication record.</p>
            <a class="text-link" href="mailto:zhuochengzhang@foxmail.com">
              Contact Zhuocheng Zhang
            </a>
          </section>
        </div>
      )
    }
  </main>
</BaseLayout>
